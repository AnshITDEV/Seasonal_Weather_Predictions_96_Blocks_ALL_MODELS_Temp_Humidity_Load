=================================\n","\n","    season_df[\"hour_sin\"] = np.sin(2*np.pi*season_df[\"hour\"]/24)\n","    season_df[\"hour_cos\"] = np.cos(2*np.pi*season_df[\"hour\"]/24)\n","\n","    season_df[\"month_sin\"] = np.sin(2*np.pi*season_df[\"month\"]/12)\n","    season_df[\"month_cos\"] = np.cos(2*np.pi*season_df[\"month\"]/12)\n","\n","    # ======================================================\n","    # Temperature Lag Features (20)\n","    # ======================================================\n","\n","    for lag in range(1,21):\n","\n","        season_df[f\"temp_lag_{lag}\"] = season_df[\"temp\"].shift(lag)\n","\n","    # ======================================================\n","    # RH Lag Features (20)\n","    # ======================================================\n","\n","    for lag in range(1,21):\n","\n","        season_df[f\"rh_lag_{lag}\"] = season_df[\"rh\"].shift(lag)\n","\n","    # ======================================================\n","    # Rolling Mean\n","    # ======================================================\n","\n","    for window in [4,8,12,24]:\n","\n","        season_df[f\"temp_mean_{window}\"] = (\n","            season_df[\"temp\"]\n","            .rolling(window)\n","            .mean()\n","        )\n","\n","        season_df[f\"rh_mean_{window}\"] = (\n","            season_df[\"rh\"]\n","            .rolling(window)\n","            .mean()\n","        )\n","\n","    # ======================================================\n","    # Rolling Std\n","    # ======================================================\n","\n","    for window in [4,8,12,24]:\n","\n","        season_df[f\"temp_std_{window}\"] = (\n","            season_df[\"temp\"]\n","            .rolling(window)\n","            .std()\n","        )\n","\n","        season_df[f\"rh_std_{window}\"] = (\n","            season_df[\"rh\"]\n","            .rolling(window)\n","            .std()\n","        )\n","\n","    # =====================================