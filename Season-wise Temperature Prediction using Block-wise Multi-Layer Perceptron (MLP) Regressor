   \"rh_change\"\n","\n","    ]\n","\n","    # ------------------------------------------------------\n","    # Final Feature List\n","    # ------------------------------------------------------\n","    feature_columns = (\n","\n","        temp_lag_features +\n","\n","        rh_lag_features +\n","\n","        temp_rolling_features +\n","\n","        rh_rolling_features +\n","\n","        trend_features\n","\n","    )\n","\n","    # Input Features\n","    X = df[feature_columns]\n","\n","    # Target Variable\n","    y = df[\"temp\"]\n","\n","    return X, y\n","\n","\n","# ==========================================================\n","# Prepare Features for Each Season\n","# ==========================================================\n","\n","X_winter, y_winter = prepare_features(winter_df)\n","\n","X_summer, y_summer = prepare_features(summer_df)\n","\n","X_monsoon, y_monsoon = prepare_features(monsoon_df)\n","\n","X_post, y_post = prepare_features(post_monsoon_df)\n","\n","print(\"=\" * 65)\n","print(\"Feature Preparation Completed\")\n","print(\"=\" * 65)\n","\n","print(f\"Winter         : {X_winter.shape}\")\n","print(f\"Summer         : {X_summer.shape}\")\n","print(f\"Monsoon        : {X_monsoon.shape}\")\n","print(f\"Post-Monsoon   : {X_post.shape}\")\n","\n","print(\"\\nTotal Features Used :\", X_winter.shape[1])"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":42,"status":"ok","timestamp":1785596328500,"user":{"displayName":"ANSH PANCHAL","userId":"02773237160992963315"},"user_tz":-330},"id":"AWC6WjGO0tlt","outputId":"0fcca91c-1318-4154-e732-af6f41221e3b"},"outputs":[{"name":"stdout","output_type":"stream","text":["============================================================\n","Train-Test Split Completed\n","============================================================\n","Winter : (59989, 30) | (14998, 30)\n","Summer : (63581, 30) | (15896, 30)\n","Monsoon: (77876, 30) | (19469, 30)\n","Post   : (37469, 30) | (9368, 30)\n"]}],"source":["# ==========================================================\n","# Step 11: Train-Test Split\n","# ==========================================================\n","\n","from sklearn.model_selection import train_test_split\n","\n","def split_dataset(X, y):\n","\n","    return train_test_split(\n","        X,\n","        y,\n","        test_size=0.20,\n","        random_state=42,\n","        shuffle=False\n","    )\n","\n","# Winter\n","X_train_w, X_test_w, y_train_w, y_test_w = split_dataset(X_winter, y_winter)\n","\n","# Summer\n","X_train_s, X_test_s, y_train_s, y_test_s = split_dataset(X_summer, y_summer)\n","\n","# Monsoon\n","X_train_m, X_test_m, y_train_m, y_test_m = split_dataset(X_monsoon, y_monsoon)\n","\n","# Post Monsoon\n","X_train_p, X_test_p, y_train_p, y_test_p = split_dataset(X_post, y_post)\n","\n","print(\"=\"*60)\n","print(\"Train-Test Split Completed\")\n","print(\"=\"*60)\n","\n","print(f\"Winter : {X_train_w.shape} | {X_test_w.shape}\")\n","print(f\"Summer : {X_train_s.shape} | {X_test_s.shape}\")\n","print(f\"Monsoon: {X_train_m.shape} | {X_test_m.shape}\")\n","print(f\"Post   : {X_train_p.shape} | {X_test_p.shape}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":164,"status":"ok","timestamp":1785596328738,"user":{"displayName":"ANSH PANCHAL","userId":"02773237160992963315"},"user_tz":-330},"id":"qEJKzqZt0yy3","outputId":"b51bc0ad-c004-4319-bcf3-eed557af45c4"},"outputs":[{"name":"stdout","output_type":"stream","text":["============================================================\n","Scaling Completed\n","============================================================\n"]}],"source":["# ==========================================================\n","# Step 12: Feature Scaling\n","# ==========================================================\n","\n","from sklearn.preprocessing import StandardScaler\n","\n","def scale_features(X_train, X_test):\n","\n","    scaler = StandardScaler()\n","\n","    X_train_scaled = scaler.fit_transform(X_train)\n","    X_test_scaled = scaler.transform(X_test)\n","\n","    return X_train_scaled, X_test_scaled, scaler\n","\n","# Winter\n","X_train_w, X_test_w, scaler_w = scale_features(X_train_w, X_test_w)\n","\n","# Summer\n","X_train_s, X_test_s, scaler_s = scale_features(X_train_s, X_test_s)\n","\n","# Monsoon\n","X_train_m, X_test_m, scaler_m = scale_features(X_train_m, X_test_m)\n","\n","# Post Monsoon\n","X_train_p, X_test_p, scaler_p = scale_features(X_train_p, X_test_p)\n","\n","print(\"=\"*60)\n","print(\"Scaling Completed\")\n","print(\"=\"*60)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/"},"id":"-35XSkGC0X2-"},"outputs":[{"name":"stdout","output_type":"stream","text":["======================================================================\n","Training Winter Model...\n","======================================================================\n","Fitting 5 folds for each of 80 candidates, totalling 400 fits\n"]}],"source":["# ==========================================================\n","# Step 13 : Train Optimized Seasonal MLP Models\n","# ==========================================================\n","\n","from sklearn.neural_network import MLPRegressor\n","from sklearn.model_selection import RandomizedSearchCV\n","from scipy.stats import loguniform\n","\n","# ----------------------------------------------------------\n","# Function to Train Best Seasonal Model\n","# ----------------------------------------------------------\n","\n","def train_season_model(X_train, y_train, season):\n","\n","    print(\"=\" * 70)\n","    print(f\"Training {season} Model...\")\n","    print(\"=\" * 70)\n","\n","    base_model = MLPRegressor(\n","        random_state=42,\n","        max_iter=3000,\n","        early_stopping=True,\n","        validation_fraction=0.10,\n","        n_iter_no_change=50\n","    )\n","\n","    param_dist = {\n","\n","        \"hidden_layer_sizes\":[\n","            (64,32),\n","            (128,64),\n","            (128,128),\n","            (128,128,64),\n","            (256,128),\n","            (256,256),\n","            (256,256,128),\n","            (512,256)\n","        ],\n","\n","        \"activation\":[\n","            \"relu\",\n","            \"tanh\"\n","        ],\n","\n","        \"solver\":[\n","            \"adam\",\n","            \"lbfgs\"\n","        ],\n","\n","        \"alpha\":loguniform(\n","            1e-6,\n","            1e-2\n","        ),\n","\n","        \"learning_rate_init\":loguniform(\n","            1e-5,\n","            1e-2\n","        ),\n","\n","        \"batch_size\":[\n","            16,\n","            32,\n","            64,\n","            128\n","        ]\n","\n","    }\n","\n","    search = RandomizedSearchCV(\n","\n","        estimator=base_model,\n","\n","        param_distributions=param_dist,\n","\n","        n_iter=80,\n","\n","        scoring=\"r2\",\n","\n","        cv=5,\n","\n","        random_state=42,\n","\n","        verbose=2,\n","\n","        n_jobs=-1\n","\n","    )\n","\n","    search.fit(X_train, y_train)\n","\n","    print(\"\\nBest Parameters\")\n","    print(search.best_params_)\n","\n","    print(\"\\nBest Validation Score\")\n","    print(search.best_score_)\n","\n","    print(\"\\nTraining Completed!\")\n","\n","    return search.best_estimator_\n","\n","\n","# ==========================================================\n","# Train Winter Model\n","# ==========================================================\n","\n","winter_model = train_season_model(\n","    X_train_w,\n","    y_train_w,\n","    \"Winter\"\n",")\n","\n","# ==========================================================\n","# Train Summer Model\n","# ==========================================================\n","\n","summer_model = train_season_model(\n","    X_train_s,\n","    y_train_s,\n","    \"Summer\"\n",")\n","\n","# ==========================================================\n","# Train Monsoon Model\n","# ==========================================================\n","\n","monsoon_model = train_season_model(\n","    X_train_m,\n","    y_train_m,\n","    \"Monsoon\"\n",")\n","\n","# ==========================================================\n","# Train Post-Monsoon Model\n","# ==========================================================\n","\n","post_monsoon_model = train_season_model(\n","    X_train_p,\n","    y_train_p,\n","    \"Post-Monsoon\"\n",")\n","\n","print(\"=\" * 70)\n","print(\"All Seasonal Models Trained Successfully!\")\n","print(\"=\" * 70)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"0CuSjq_7K4uI"},"outputs":[],"source":["# ==========================================================\n","# Step 14: Generate Temperature Predictions\n","# ==========================================================\n","\n","# ----------------------------------------------------------\n","# Function to generate predictions using a trained MLP model\n","# ----------------------------------------------------------\n","\n","def predict_temperature(model, X_test):\n","\n","    # Predict temperature values\n","    predictions = model.predict(X_test)\n","\n","    return predictions\n","\n","\n","# ----------------------------------------------------------\n","# Generate Predictions for Winter Dataset\n","# ----------------------------------------------------------\n","\n","winter_predictions = predict_temperature(\n","    winter_model,\n","    X_test_w\n",")\n","\n","# ----------------------------------------------------------\n","# Generate Predictions for Summer Dataset\n","# ----------------------------------------------------------\n","\n","summer_predictions = predict_temperature(\n","    summer_model,\n","    X_test_s\n",")\n","\n","# ----------------------------------------------------------\n","# Generate Predictions for Monsoon Dataset\n","# ----------------------------------------------------------\n","\n","monsoon_predictions = predict_temperature(\n","    monsoon_model,\n","    X_test_m\n",")\n","\n","# ----------------------------------------------------------\n","# Generate Predictions for Post-Monsoon Dataset\n","# ----------------------------------------------------------\n","\n","post_predictions = predict_temperature(\n","    post_monsoon_model,\n","    X_test_p\n",")\n","\n","print(\"=\" * 60)\n","print(\"Temperature Predictions Generated Successfully!\")\n","print(\"=\" * 60)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"L2CEGvfFK7VX"},"outputs":[],"source":["# ==========================================================\n","# Step 15: Evaluate Seasonal MLP Models\n","# ==========================================================\n","\n","# Import evaluation metrics\n","from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n","import numpy as np\n","import pandas as pd\n","\n","# ----------------------------------------------------------\n","# Function to evaluate a trained MLP model\n","# ----------------------------------------------------------\n","\n","def evaluate_model(season_name, y_test, predictions):\n","\n","    # Calculate evaluation metrics\n","    mae = mean_absolute_error(y_test, predictions)\n","    mse = mean_squared_error(y_test, predictions)\n","    rmse = np.sqrt(mse)\n","    r2 = r2_score(y_test, predictions)\n","\n","    # Return all metrics\n","    return {\n","        \"Season\": season_name,\n","        \"MAE\": round(mae, 4),\n","        \"RMSE\": round(rmse, 4),\n","        \"R² Score\": round(r2, 4)\n","    }\n","\n","\n","# ----------------------------------------------------------\n","# Evaluate all Seasonal Models\n","# ----------------------------------------------------------\n","\n","results = []\n","\n","results.append(evaluate_model(\"Winter\", y_test_w, winter_predictions))\n","results.append(evaluate_model(\"Summer\", y_test_s, summer_predictions))\n","results.append(evaluate_model(\"Monsoon\", y_test_m, monsoon_predictions))\n","results.append(evaluate_model(\"Post-Monsoon\", y_test_p, post_predictions))\n","\n","# Convert results into a DataFrame\n","results_df = pd.DataFrame(results)\n","\n","print(\"=\" * 70)\n","print(\"Season-wise MLP Model Performance\")\n","print(\"=\" * 70)\n","\n","display(results_df)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"FmHrWpsQLaTQ"},"outputs":[],"source":["# ==========================================================\n","# Step 16: Actual vs Predicted Temperature Graphs\n","# ==========================================================\n","\n","# Import plotting library\n","import matplotlib.pyplot as plt\n","\n","# ----------------------------------------------------------\n","# Function to plot Actual vs Predicted Temperature\n","# ----------------------------------------------------------\n","\n","def plot_predictions(season_name, y_test, predictions):\n","\n","    # Create figure\n","    plt.figure(figsize=(14,5))\n","\n","    # Plot Actual Temperature\n","    plt.plot(\n","        y_test.values[:500],\n","        label=\"Actual Temperature\",\n","        linewidth=2\n","    )\n","\n","    # Plot Predicted Temperature\n","    plt.plot(\n","        predictions[:500],\n","        label=\"Predicted Temperature\",\n","        linewidth=2\n","    )\n","\n","    # Graph Details\n","    plt.title(f\"{season_name} : Actual vs Predicted Temperature\")\n","    plt.xlabel(\"Sample Index\")\n","    plt.ylabel(\"Temperature (°C)\")\n","    plt.legend()\n","    plt.grid(True)\n","\n","    # Display Graph\n","    plt.show()\n","\n","\n","# ----------------------------------------------------------\n","# Plot Graphs for all Seasons\n","# ----------------------------------------------------------\n","\n","plot_predictions(\"Winter\", y_test_w, winter_predictions)\n","\n","plot_predictions(\"Summer\", y_test_s,